# syntax=docker/dockerfile:1

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dispatch-agent ./cmd/dispatch-agent

FROM docker:29-cli
COPY --from=build /out/dispatch-agent /usr/local/bin/dispatch-agent
RUN addgroup -S dispatch && adduser -S -G dispatch dispatch
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/dispatch-agent"]
