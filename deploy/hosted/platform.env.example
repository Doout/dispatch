DISPATCH_HOSTED_ROOT_DOMAIN=dispatch.example.com
DISPATCH_HOSTED_DATA_DIR=/var/lib/dispatch-platform
DISPATCH_HOSTED_CATALOG_URL_FILE=/etc/dispatch-platform/catalog-url
DISPATCH_HOSTED_POSTGRES_ADMIN_URL_FILE=/etc/dispatch-platform/provisioner-url
DISPATCH_HOSTED_CONSOLE_ADDRESSES=192.0.2.10
DISPATCH_HOSTED_NAMESERVERS=ns1.dispatch.example.com,ns2.dispatch.example.com
DISPATCH_HOSTED_NAMESERVER_ADDRESSES=ns1.dispatch.example.com=192.0.2.53,ns2.dispatch.example.com=198.51.100.53
DISPATCH_HOSTED_DNS_TOKEN_FILE=/etc/dispatch-platform/dns-token
DISPATCH_HOSTED_ADDR=127.0.0.1:8081
DISPATCH_HOSTED_TLS_MODE=proxy
DISPATCH_HOSTED_TRUSTED_PROXIES=127.0.0.1/32,::1/128
DISPATCH_EDGE_BINARY_ROOT=/opt/dispatch/current/edge
# Set after the workload ingress is ready.
# DISPATCH_HOSTED_WORKLOAD_GATEWAY=192.0.2.20
# Registration needs a verified STARTTLS SMTP service.
# DISPATCH_HOSTED_SMTP_ADDRESS=smtp.example.com:587
# DISPATCH_HOSTED_SMTP_FROM=dispatch@example.com
# DISPATCH_HOSTED_SMTP_USERNAME=dispatch
# DISPATCH_HOSTED_SMTP_PASSWORD_FILE=/etc/dispatch-platform/smtp-password
