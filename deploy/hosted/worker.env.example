DISPATCH_EDGE_CONTROLLER_URL=https://tenant.dispatch.example.com
DISPATCH_EDGE_NODE_ID=replace-with-enrolled-node-id
DISPATCH_WORKER_STATE=/var/lib/dispatch-worker
# Copy the full dispatch-worker image reference from the release's images.txt.
DISPATCH_WORKER_IMAGE=replace-with-versioned-image-and-sha256-digest
DISPATCH_WORKER_MODE=tenant
DISPATCH_WORKER_DOCKER=false
DISPATCH_WORKER_CPUS=1
DISPATCH_WORKER_MEMORY_MIB=1024
DISPATCH_WORKER_DISK_MIB=2048
DISPATCH_WORKER_PIDS=256
# Remove after the first successful enrollment.
# DISPATCH_EDGE_TOKEN=replace-with-single-use-enrollment-token
