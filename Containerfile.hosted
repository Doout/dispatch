# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM node:22.14-alpine AS web
WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/pnpm/store npm install --global pnpm@11.18.0 && pnpm install --frozen-lockfile --store-dir /pnpm/store
COPY web/ ./
RUN pnpm build

FROM --platform=$BUILDPLATFORM golang:1.27.2-bookworm AS build
ARG TARGETOS
ARG TARGETARCH
ARG DISPATCH_VERSION=development
RUN apt-get update && apt-get install -y --no-install-recommends gcc-x86-64-linux-gnu g++-x86-64-linux-gnu gcc-aarch64-linux-gnu g++-aarch64-linux-gnu && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY --from=web /src/internal/ui/dist ./internal/ui/dist
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build case "${TARGETARCH}" in amd64) export CC=x86_64-linux-gnu-gcc CXX=x86_64-linux-gnu-g++ ;; arm64) export CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ ;; esac; CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w -X github.com/doout/dispatch/internal/installation.Version=${DISPATCH_VERSION}" -o /out/dispatch-platform ./cmd/dispatch-platform && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/edge/linux-amd64 ./cmd/dispatch-agent && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o /out/edge/linux-arm64 ./cmd/dispatch-agent

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git openssh-client libstdc++6 && rm -rf /var/lib/apt/lists/* && groupadd -g 65532 dispatch && useradd -u 65532 -g dispatch -M dispatch
COPY LICENSE web/public/fonts/OFL-Manrope.txt /usr/share/licenses/dispatch/
USER 65532:65532
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/dispatch-platform"]

FROM runtime AS release
ARG TARGETARCH
COPY release/${TARGETARCH}/dispatch-platform /usr/local/bin/dispatch-platform
COPY release/edge /usr/local/lib/dispatch-edge

FROM runtime AS platform
COPY --from=build /out/dispatch-platform /usr/local/bin/dispatch-platform
COPY --from=build /out/edge /usr/local/lib/dispatch-edge
