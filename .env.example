DISPATCH_ADDR=:8080
DISPATCH_HOST=dispatch.localhost
DATABASE_URL=dispatch.db
DISPATCH_EXECUTOR=simulation
DISPATCH_DEMO=false
# This controller is registered automatically when this socket is mounted.
DISPATCH_DOCKER_SOCKET=/var/run/docker.sock
HELM_REPOSITORY_USERNAME=
HELM_REPOSITORY_PASSWORD=
# Match the group ID that owns /var/run/docker.sock on the host.
DOCKER_GID=1001
# Kubeconfig files are mounted read-only here and must be readable by this group.
DISPATCH_KUBECONFIG_DIR=./kubeconfigs
# Leave both blank to create the first administrator through the UI or API.
DISPATCH_ADMIN_USERNAME=
DISPATCH_ADMIN_PASSWORD=
# Optional bearer token for API automation.
DISPATCH_ADMIN_TOKEN=
# Pull request preview events remain disabled until a webhook secret is set.
DISPATCH_GITHUB_WEBHOOK_SECRET=
DISPATCH_PREVIEW_COMMAND=/preview
DISPATCH_GITHUB_API_URL=https://api.github.com
DISPATCH_GITHUB_TOKEN=
# Optional bearer token used when hooks check out private source repositories.
DISPATCH_GIT_TOKEN=
# Shared bare repositories; each run receives its own detached worktree.
DISPATCH_REPOSITORY_CACHE=repository-cache
# Explicitly scoped credentials available to pre/post hooks for image pushes.
DISPATCH_HOOK_REGISTRY=
DISPATCH_HOOK_REGISTRY_USERNAME=
DISPATCH_HOOK_REGISTRY_PASSWORD=
# DISPATCH_MASTER_KEY_FILE=/run/secrets/dispatch_master_key
