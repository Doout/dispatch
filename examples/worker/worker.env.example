DISPATCH_WORKER_STATE=/var/lib/dispatch-worker
# Replace this with the immutable ID from docker image inspect.
DISPATCH_WORKER_IMAGE=sha256:REPLACE_WITH_LOCAL_IMAGE_ID
DISPATCH_WORKER_MODE=tenant
DISPATCH_WORKER_DOCKER=true
DISPATCH_WORKER_CPUS=2
DISPATCH_WORKER_MEMORY_MIB=2048
DISPATCH_WORKER_DISK_MIB=2048
DISPATCH_WORKER_PIDS=256
